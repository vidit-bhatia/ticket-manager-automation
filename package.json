    "type": "git",
    "url": "https://github.com/vidit-bhatia/ticket-manager-automation.git"
  },
  "bugs": {
    "url": "https://github.com/vidit-bhatia/ticket-manager-automation/issues"
  },
  "homepage": "https://github.com/vidit-bhatia/ticket-manager-automation#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {},
  "devDependencies": {},
  "optionalDependencies": {
    "gstack": "*"
  }
